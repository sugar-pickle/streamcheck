# Radarr (movies) - Settings > General > API Key
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Sonarr (TV) - Settings > General > API Key
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# JustWatch country (ISO 3166-1 alpha-2). You can also change it in the UI.
COUNTRY=GB

# Optional: rescan automatically every N hours (0 = only scan manually)
SCAN_INTERVAL_HOURS=0

# Optional: protect the UI with HTTP basic auth (recommended, since it can delete media)
AUTH_USERNAME=
AUTH_PASSWORD=
